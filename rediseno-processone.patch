+.pd-phva{display:grid;grid-template-columns:repeat(6,1fr);gap:3px}.pd-phva i{height:22px;border-radius:5px;background:#e5ebf5;display:grid;place-items:center;font-style:normal;font-size:11px;font-weight:700;color:var(--pd-muted)}.pd-phva i.on{background:#cfe2f9;color:var(--pd-blue-d)}
