+.pd-animal-hero .pd-animal{box-shadow:0 8px 24px #0006}
+.pd-animal-bob{animation:pd-bob 3.2s ease-in-out infinite}
+@keyframes pd-bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
+.pd-picker{display:grid;grid-template-columns:repeat(auto-fill,minmax(86px,1fr));gap:10px}
+.pd-pick{display:grid;gap:4px;justify-items:center;padding:10px 4px;border:2px solid var(--pd-line);border-radius:14px;background:#fff;cursor:pointer;font:inherit;font-size:12px;font-weight:600;color:var(--pd-muted)}
+.pd-pick:hover{border-color:#9db9e0;transform:translateY(-2px)}.pd-pick[aria-pressed=true]{border-color:var(--pd-blue);background:#eef5fd;color:var(--pd-blue-d)}
+.pd-arena{position:relative;min-height:320px;border-radius:var(--pd-r);border:1px solid var(--pd-line);background:linear-gradient(180deg,#eaf3fd,#f8fbff);overflow:hidden}
+.pd-arena .pd-mover{position:absolute;display:grid;justify-items:center;gap:3px;cursor:grab;touch-action:none;user-select:none;font-size:12px;font-weight:700;color:var(--pd-navy)}
+.pd-arena .pd-mover.moving{cursor:grabbing;z-index:4}
+.pd-arena .pd-mover span.name{background:#fffc;border-radius:99px;padding:1px 8px;max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+
+/* Selector de tipo de proyecto (formulario) */
+.pd-kind-picker{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
+.pd-kind-picker button{text-align:left;font:inherit;border:2px solid var(--pd-line);background:#fff;border-radius:12px;padding:10px 12px;display:grid;gap:3px;cursor:pointer;color:var(--pd-ink)}
+.pd-kind-picker button b{font-size:14px;color:var(--pd-navy)}.pd-kind-picker button small{color:var(--pd-muted);line-height:1.4}
+.pd-kind-picker button.on{border-color:var(--pd-blue);background:#eef5fd}
+.pd-kind-picker button:focus-visible{outline:none;box-shadow:var(--pd-focus)}
+.avatar-user{background:transparent!important;padding:0!important;border:0!important;width:auto!important;height:auto!important;display:inline-grid;place-items:center;cursor:pointer}
+.pd-stages-wide{grid-template-columns:repeat(4,minmax(0,1fr))}
+.pd-stages-wide .pd-stage-cell{min-height:70px;font-size:12px}
+.pd-stage-cell{overflow-wrap:anywhere;hyphens:auto}
+
+/* Tareas: barra de filtros en una fila y texto legible */
+.task-filter-bar{display:flex!important;flex-wrap:wrap;gap:10px;align-items:center;padding:12px 14px!important}
+.task-filter-bar .input,.task-filter-bar .filter-select{width:auto!important;min-width:150px;height:40px;font-size:13px!important}
+.task-filter-bar .task-search{flex:1;min-width:220px}.task-filter-bar .task-search input{font-size:13px!important}
+.task-table td,.task-table th{font-size:13px!important}.task-table small,.task-table td small{font-size:12px!important}
+.task-table select,.task-table .input{font-size:12px!important;min-height:34px}
+.view-switch{display:inline-flex;gap:2px;background:#e9eef7;border-radius:11px;padding:3px;margin-left:auto}
+.view-switch button{min-width:40px;min-height:36px;border:0;border-radius:8px;background:transparent;color:var(--pd-muted);cursor:pointer;display:grid;place-items:center}
+.view-switch button.view-active{background:#fff;color:var(--pd-blue-d);box-shadow:0 1px 4px #102a5c1f}
+.kanban-card,.kanban-column{font-size:13px}
