@@ -0,0 +1,173 @@
+/* ProcessOne · Capa de diseño unificada (prefijo pd-). Se importa al final para armonizar botones, tamaños y color. */
+:root{
+  --pd-blue:#1565c0;--pd-blue-d:#0d4a92;--pd-navy:#102a5c;--pd-teal:#0aa89f;--pd-ink:#1b2a4a;--pd-muted:#51607d;
+  --pd-line:#dfe6f1;--pd-bg:#f3f6fb;--pd-card:#fff;--pd-r:14px;--pd-r-s:9px;--pd-sh:0 1px 2px #102a5c0f,0 6px 18px #102a5c0d;
+  --pd-red:#c4314b;--pd-amber:#b86e0a;--pd-green:#14804a;--pd-focus:0 0 0 3px #1565c040;
+}
+/* Tamaño mínimo de texto legible en todo el sistema */
+.main-area small,.main-area .badge,.main-area th,.main-area label span,.nav-group-label{font-size:max(12px,1em)}
+.main-area small{font-size:12px}
+/* Botones: una sola familia, mismo alto y radio en toda la app */
+.button,.top-add-button,.text-action{border-radius:var(--pd-r-s);font-weight:600;transition:background .15s,box-shadow .15s,transform .15s}
+.button{min-height:40px;font-size:13px}
+.button-primary,.top-add-button{background:var(--pd-blue);border-color:var(--pd-blue);color:#fff}
+.button-primary:hover,.top-add-button:hover{background:var(--pd-blue-d)}
+.button:focus-visible,.pd-seg button:focus-visible,.pd-card:focus-visible,.pd-item:focus-visible{outline:none;box-shadow:var(--pd-focus)}
+.text-action{color:var(--pd-blue-d)}
+@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
+
+/* Estructura */
+.pd-page{display:grid;gap:18px}
+.pd-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap}
+.pd-head h2{margin:2px 0 4px;font-size:22px;color:var(--pd-navy);letter-spacing:-.01em}
+.pd-head p{margin:0;color:var(--pd-muted);font-size:14px;max-width:760px;line-height:1.5}
+.pd-eyebrow{font-size:12px;font-weight:700;letter-spacing:.08em;color:var(--pd-blue);text-transform:uppercase}
+.pd-head-actions,.pd-toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
+.pd-toolbar{background:var(--pd-card);border:1px solid var(--pd-line);border-radius:var(--pd-r);padding:10px 12px;box-shadow:var(--pd-sh)}
+.pd-toolbar .grow{flex:1}
+.pd-field{display:grid;gap:3px;font-size:12px;color:var(--pd-muted);font-weight:600}
+.pd-field select,.pd-field input{min-height:38px;border:1px solid var(--pd-line);border-radius:var(--pd-r-s);padding:0 10px;font-size:13px;color:var(--pd-ink);background:#fff;min-width:150px}
+.pd-field select:focus,.pd-field input:focus{outline:none;box-shadow:var(--pd-focus);border-color:var(--pd-blue)}
+.pd-card{background:var(--pd-card);border:1px solid var(--pd-line);border-radius:var(--pd-r);box-shadow:var(--pd-sh);padding:16px}
+.pd-card h3{margin:0 0 2px;font-size:15px;color:var(--pd-navy)}
+.pd-card>header p,.pd-sub{margin:0 0 10px;color:var(--pd-muted);font-size:13px}
+.pd-grid{display:grid;gap:14px}
+.pd-g2{grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}
+.pd-g3{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
+.pd-g4{grid-template-columns:repeat(auto-fit,minmax(190px,1fr))}
+.pd-split{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,1fr);gap:14px}
+@media(max-width:980px){.pd-split{grid-template-columns:1fr}}
+
+/* Selector segmentado */
+.pd-seg{display:inline-flex;background:#e9eef7;border-radius:11px;padding:3px;gap:2px;flex-wrap:wrap}
+.pd-seg button{display:inline-flex;align-items:center;gap:6px;border:0;background:transparent;border-radius:8px;min-height:34px;padding:0 12px;font-size:13px;font-weight:600;color:var(--pd-muted);cursor:pointer}
+.pd-seg button:hover{color:var(--pd-navy)}
+.pd-seg button.on{background:#fff;color:var(--pd-blue-d);box-shadow:0 1px 4px #102a5c1f}
+.pd-seg em{font-style:normal;font-size:12px;background:#dfe7f5;border-radius:99px;padding:0 7px;color:var(--pd-muted)}
+.pd-seg button.on em{background:#e6f0fc;color:var(--pd-blue-d)}
+
+/* Etiquetas */
+.pd-tag{display:inline-flex;align-items:center;gap:6px;border:1px solid;border-radius:99px;padding:2px 9px;font-size:12px;font-weight:700;white-space:nowrap;max-width:100%}
+.pd-tag i{width:8px;height:8px;border-radius:50%;flex:none}
+.pd-tag-name{font-weight:600;overflow:hidden;text-overflow:ellipsis;max-width:180px}
+.pd-kind,.pd-method{display:inline-flex;align-items:center;border-radius:6px;padding:2px 8px;font-size:12px;font-weight:700;white-space:nowrap}
+.pd-method{background:#eef2f9;color:#33456b}.pd-method.none{background:#f4f6fa;color:#6b7893;font-weight:600;font-style:italic}
+
+/* Métricas */
+.pd-stat{display:grid;gap:2px;text-align:left;background:var(--pd-card);border:1px solid var(--pd-line);border-left:4px solid var(--pd-blue);border-radius:var(--pd-r);padding:13px 15px;box-shadow:var(--pd-sh);font:inherit;color:inherit}
+.pd-stat.click{cursor:pointer}.pd-stat.click:hover{transform:translateY(-1px);border-color:#b9cbe6}
+.pd-teal{border-left-color:var(--pd-teal)}.pd-amber{border-left-color:#e0872b}.pd-red{border-left-color:var(--pd-red)}.pd-violet{border-left-color:#7c5cc4}
+.pd-stat-label{font-size:12px;font-weight:700;color:var(--pd-muted);text-transform:uppercase;letter-spacing:.04em}
+.pd-stat-value{font-size:28px;line-height:1.1;color:var(--pd-navy);font-weight:800}
+.pd-stat-note{font-size:12px;color:var(--pd-muted)}
+
+/* Anillo y barra */
+.pd-ring{position:relative;display:inline-grid;place-items:center;flex:none}
+.pd-ring svg{position:absolute;inset:0}.pd-ring-bg{fill:none;stroke:#e5ebf5;stroke-width:6}.pd-ring-fg{fill:none;stroke-width:6;stroke-linecap:round;transition:stroke-dashoffset .5s}
+.pd-ring b{color:var(--pd-navy);position:relative}
+.pd-bar{display:block;height:7px;border-radius:9px;background:#e5ebf5;overflow:hidden;min-width:60px}.pd-bar i{display:block;height:100%;border-radius:9px;transition:width .4s}
+
+/* Tarjeta de macroiniciativa / proyecto */
+.pd-macro-card{position:relative;text-align:left;font:inherit;color:inherit;background:var(--pd-card);border:1px solid var(--pd-line);border-top:4px solid var(--m,#1565c0);border-radius:var(--pd-r);box-shadow:var(--pd-sh);padding:14px;display:grid;gap:10px;cursor:pointer;transition:transform .15s,box-shadow .15s}
+.pd-macro-card:hover{transform:translateY(-2px);box-shadow:0 10px 26px #102a5c1f}
+.pd-macro-card[aria-pressed=true]{outline:2px solid var(--m);outline-offset:1px}
+.pd-macro-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
+.pd-macro-card h4{margin:6px 0 0;font-size:14px;color:var(--pd-navy);line-height:1.3}
+.pd-macro-nums{display:flex;gap:14px;font-size:12px;color:var(--pd-muted)}.pd-macro-nums b{display:block;font-size:17px;color:var(--pd-navy)}
+
+/* Etapas (distribución) */
+.pd-stages{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
+.pd-stage-cell{background:#f3f6fb;border-radius:10px;padding:8px 6px;text-align:center;font-size:11px;color:var(--pd-muted);line-height:1.2;min-height:62px;display:grid;align-content:space-between}
+.pd-stage-cell b{font-size:20px;color:var(--pd-navy)}.pd-stage-cell.has{background:#e6f0fc}
+@media(max-width:700px){.pd-stages{grid-template-columns:repeat(4,1fr)}}
+
+/* Elementos de trabajo (lista) */
+.pd-list{display:grid;gap:8px}
+.pd-item{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;text-align:left;font:inherit;color:inherit;background:#fff;border:1px solid var(--pd-line);border-left:4px solid var(--m,#7b8aa5);border-radius:11px;padding:10px 12px;cursor:pointer}
+.pd-item:hover{border-color:#b9cbe6;background:#fafcff}
+.pd-item strong{display:block;font-size:14px;color:var(--pd-ink);line-height:1.3}.pd-item small{color:var(--pd-muted)}
+.pd-due{font-size:12px;font-weight:700;color:var(--pd-muted);white-space:nowrap}.pd-due.late{color:var(--pd-red)}.pd-due.soon{color:var(--pd-amber)}
+.pd-pill{font-size:12px;font-weight:700;border-radius:99px;padding:2px 9px;background:#eef2f9;color:#33456b;white-space:nowrap}
+.pd-pill.s-curso{background:#e6f0fc;color:#0d4a92}.pd-pill.s-rev{background:#fdf0e0;color:#8f5207}.pd-pill.s-ok{background:#e3f5ea;color:#14663b}.pd-pill.s-blk{background:#fde8ec;color:#a02339}
+.pd-dot{width:18px;height:18px;border-radius:50%;border:2px solid #aab7cf;display:inline-block}
+.pd-dot.s-curso{border-color:#1565c0;background:radial-gradient(#1565c0 40%,transparent 45%)}.pd-dot.s-rev{border-color:#e0872b;background:radial-gradient(#e0872b 40%,transparent 45%)}.pd-dot.s-ok{border-color:#14804a;background:#14804a}.pd-dot.s-blk{border-color:#c4314b;background:#c4314b}
+
+/* Tablero (kanban / canvas) */
+.pd-board{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(250px,1fr);gap:12px;overflow-x:auto;padding-bottom:8px;scroll-snap-type:x proximity}
+.pd-col{background:#e9eef7;border-radius:var(--pd-r);padding:10px;display:grid;gap:8px;align-content:start;min-height:160px;scroll-snap-align:start}
+.pd-col.over{outline:2px dashed var(--pd-blue);background:#e0ecfa}
+.pd-col>header{display:flex;justify-content:space-between;align-items:center;font-weight:800;font-size:13px;color:var(--pd-navy);padding:2px 4px}
+.pd-col>header em{font-style:normal;background:#fff;border-radius:99px;padding:0 9px;font-size:12px;color:var(--pd-muted)}
+.pd-kcard{background:#fff;border:1px solid var(--pd-line);border-left:4px solid var(--m,#7b8aa5);border-radius:11px;padding:10px 11px;display:grid;gap:7px;cursor:grab;box-shadow:0 1px 3px #102a5c10}
+.pd-kcard:active{cursor:grabbing}.pd-kcard.drag{opacity:.45}
+.pd-kcard strong{font-size:13px;color:var(--pd-ink);line-height:1.3}.pd-kcard small{color:var(--pd-muted)}
+.pd-kcard-actions{display:flex;gap:6px;flex-wrap:wrap}
+.pd-mini{min-height:30px;border:1px solid var(--pd-line);background:#fff;border-radius:8px;padding:0 10px;font-size:12px;font-weight:600;color:var(--pd-blue-d);cursor:pointer}
+.pd-mini:hover{background:#eef4fc}.pd-mini.warn{color:var(--pd-red)}
+.pd-hint{font-size:12px;color:var(--pd-muted);margin:0}
+
+/* Canvas libre */
+.pd-canvas{position:relative;min-height:520px;border:1px solid var(--pd-line);border-radius:var(--pd-r);background-color:#f8fafd;background-image:radial-gradient(#cfd9ea 1px,transparent 1px);background-size:22px 22px;overflow:auto}
+.pd-node{position:absolute;width:230px;background:#fff;border:1px solid var(--pd-line);border-top:4px solid var(--m,#1565c0);border-radius:12px;padding:10px 12px;box-shadow:var(--pd-sh);cursor:grab;touch-action:none;user-select:none}
+.pd-node.moving{cursor:grabbing;box-shadow:0 14px 30px #102a5c33;z-index:5}
+.pd-node strong{font-size:13px;color:var(--pd-navy);display:block;margin:4px 0}
+
+/* Solicitudes */
+.pd-req{display:grid;gap:10px;border-left:5px solid #7b8aa5}
+.pd-req.pendiente{border-left-color:#e0872b}.pd-req.aprobada{border-left-color:#14804a}.pd-req.rechazada{border-left-color:var(--pd-red)}
+.pd-req-meta{display:flex;gap:8px;flex-wrap:wrap;align-items:center;color:var(--pd-muted);font-size:12px}
+.pd-empty{display:grid;gap:6px;justify-items:center;text-align:center;padding:30px 16px;border:2px dashed var(--pd-line);border-radius:var(--pd-r);color:var(--pd-muted);background:#fbfcfe}
+.pd-empty b{color:var(--pd-navy);font-size:15px}.pd-empty p{margin:0;max-width:440px;font-size:13px}
+
+/* Mapa de flujo: macroiniciativa → metodología → proyecto */
+.pd-flow{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;position:relative}
+.pd-flow-col{display:grid;gap:10px;align-content:start}
+.pd-flow-col>h4{margin:0;font-size:12px;letter-spacing:.07em;text-transform:uppercase;color:var(--pd-muted)}
+.pd-node-btn{text-align:left;font:inherit;color:inherit;background:#fff;border:1px solid var(--pd-line);border-left:5px solid var(--m,#1565c0);border-radius:11px;padding:10px 12px;cursor:pointer;display:grid;gap:3px;transition:opacity .2s,box-shadow .15s}
+.pd-node-btn:hover{box-shadow:0 6px 18px #102a5c1a}.pd-node-btn.dim{opacity:.35}.pd-node-btn.sel{box-shadow:0 0 0 2px var(--m,#1565c0)}
+.pd-node-btn strong{font-size:13px;color:var(--pd-navy)}.pd-node-btn small{color:var(--pd-muted)}
